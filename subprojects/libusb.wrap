[wrap-file]
directory = libusb-1.0.30
source_url = https://github.com/libusb/libusb/releases/download/v1.0.30/libusb-1.0.30.tar.bz2
source_filename = libusb-1.0.30.tar.bz2
source_hash = fea36f34f9156400209595e300840767ab1a385ede1dc7ee893015aea9c6dbaf
source_fallback_url = https://wrapdb.mesonbuild.com/v2/libusb_1.0.30-1/get_source/libusb-1.0.30.tar.bz2
# The meson build files are those of WrapDB's libusb_1.0.30-1, copied to
# packagefiles/libusb with a fix that makes -Dlibusb:windows-hotplug=true build.
# meson copies them over the sources without any external tool. There is no
# wrapdb_version, so that 'meson wrap update libusb' does not bring back the
# WrapDB build files: go back to WrapDB's patch_url and patch_hash once one of
# its revisions builds libusb/os/windows_hotplug.c.
patch_directory = libusb

[provide]
dependency_names = libusb-1.0
